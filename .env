# Application / DB settings for Docker
# If your DB is running on the host machine, `host.docker.internal` lets containers reach it on Docker for Windows/Mac.
# Otherwise set this to the DB service name (db) when using the included MySQL container.
DB_HOST=host.docker.internal
DB_NAME=explorekenya
DB_USER=sa
DB_PASS=Wise12.,

# MySQL docker-compose initialization variables
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=explorekenya
MYSQL_USER=sa
MYSQL_PASSWORD=Wise12.,

# Optional: change web port mapping by editing docker-compose.yml